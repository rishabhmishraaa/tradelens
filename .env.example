# Names only, no values. Add each variable when a feature first needs it.

# Neon main branch (the app's real data)
DATABASE_URL=
# Neon "test" branch: wiped and re-seeded by `npm test` (D13). Must differ from DATABASE_URL.
TEST_DATABASE_URL=

# Owner login (D10). Create with: npm run hash-password -- "a long random password"
OWNER_PASSWORD_HASH=
# Signs the session cookie. At least 32 random characters.
SESSION_SECRET=

# AI session review (F7). Server-only; never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Model id, e.g. from https://docs.claude.com (D15: never hard-coded in source).
ANTHROPIC_MODEL=
# live (default) or mock. mock = fake model for tests; refused when VERCEL_ENV=production (D14).
AI_MODE=
